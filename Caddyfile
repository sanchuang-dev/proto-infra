# Managed by sanchuang-dev/proto-infra
# Prototype gateway: static snapshots plus explicitly approved system-prototype proxies.
# Every hostname is declared; DNS must point to the company prototype server.
proto.3cgroup.cn {
    root * /srv/proto/portal/current
    encode zstd gzip
    file_server
}

ai-mirror.proto.3cgroup.cn {
    basic_auth {
        demo {env.PROTO_AI_MIRROR_HASH}
    }
    root * /srv/proto/ai-mirror/current
    encode zstd gzip
    try_files {path} /index.html
    file_server
}

