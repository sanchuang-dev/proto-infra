# Benefit Hub is a system-level prototype, not a live entitlement fulfillment service.
# Application lifecycle is owned by sanchuang-dev/benefit-hub (dev); Caddy stays here.
benefit.proto.3cgroup.cn {
    encode zstd gzip
    header X-Robots-Tag "noindex, nofollow"
    reverse_proxy 127.0.0.1:18080
}
